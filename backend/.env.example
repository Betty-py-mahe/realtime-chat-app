# Port the server listens on. Render/Railway inject this automatically in production.
PORT=5000

# Comma-separated list of origins allowed to call the API / open a socket connection.
# Include your GitHub Pages URL and http://localhost:5173 for local frontend dev.
CLIENT_ORIGIN=http://localhost:5173,https://YOUR_GITHUB_USERNAME.github.io

# Path to the SQLite database file. A relative path keeps it inside the backend folder.
DB_PATH=./data/chat.db
